---
import Container from "./Container.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section-padding border-y border-white/10 bg-black/20">
  <Container>
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <SectionHeading
          eyebrow="Brand Story"
          title="Facilities in Wisconsin and Arizona, serving nationwide"
          description="Athletic Rubber Converting is committed to providing high-quality, specification-driven rubber flooring for all applications."
        />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="card-shell p-3">
          <div class="image-frame aspect-[8/6] rounded-[1.25rem]">
            <img src="/images/brand/WI_Sign_Dock.jpg" alt="Athletic Rubber Converting brand or facility image" class="h-full w-full object-cover" loading="lazy" />
          </div>
        </div>
        <div class="grid gap-4">
          <div class="card-shell p-3">
            <div class="image-frame aspect-[6/6] rounded-[1.25rem]">
              <img src="/images/hero/arc-hero-detail.jpg" alt="AthleticRC operations detail" class="h-full w-full object-cover" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>